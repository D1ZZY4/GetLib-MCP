# ============================================================
# Dependencies
# Never commit installed packages — they are reproducible
# from package.json + bun.lock via `bun install`.
# ============================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package-manager lockfiles.
# This repo standardizes on Bun (see vercel.json + Dockerfile),
# so bun.lock is the ONE canonical lockfile and MUST be committed.
# Ignore locks from other managers to avoid dual-lockfile drift.
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Build output (Next.js / TypeScript)
# Regenerated by `bun run build` — never commit.
# ============================================================
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ============================================================
# Environment & secrets — NEVER commit real credentials.
# Only .env.example (placeholder keys, no values) is committed.
# ============================================================
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ============================================================
# Logs, coverage & test artifacts
# ============================================================
logs/
*.log
coverage/
.nyc_output/
junit*.xml
test-results/
playwright-report/
playwright/.cache/

# ============================================================
# Caches & tooling (regenerable, machine-specific)
# ============================================================
.turbo
.parcel-cache/
.eslintcache
.stylelintcache
.biome/
.calibre/
*.tmp
*.temp

# ============================================================
# OS junk
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================
# Editors & IDEs (personal settings, not project config)
# Keep .vscode/extensions.json committed (shared recommendations);
# everything else under .vscode/ is personal.
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.project
.classpath
.settings/

# ============================================================
# Deployment — local / generated only
# ============================================================
.vercel
docker-compose.override.yml

# ============================================================
# Replit & local machine state (root-only, hence the leading /)
# These are host-specific caches/configs from the dev environment,
# including thousands of cached package files that would otherwise
# slow down Tailwind v4 content scanning. Never commit.
# ============================================================
/.cache/
/.local/
/.config/
/.upm/
.replit
replit.nix
profile.txt

# Local secrets & key material (root-only). Private keys, backups,
# and any credential exports must never enter git history.
# ============================================================
/gpg-key-backup/

# ============================================================
# NOTE — intentionally COMMITTED, do NOT add ignore rules for:
#   bun.lock            canonical lockfile (reproducible installs)
#   .agents/            shared agent rules & skills
#   AGENTS.md, CLAUDE.md, opencode.json, skills-lock.json
#   Dockerfile, .dockerignore, vercel.json
# ============================================================
