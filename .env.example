# GetLib MCP - environment placeholders (no real values).
# Copy to .env for local development. Never commit real credentials.

# GitHub token for higher API rate limits (optional).
GETLIB_GITHUB_TOKEN=

# Persistent disk cache directory (optional, defaults to ~/.getlib-mcp-cache).
GETLIB_CACHE_DIR=

# Max concurrent fetch workers for auto-scan (optional, default 8).
GETLIB_CONCURRENCY=

# Set to 1 to disable invisible response watermarking (optional).
GETLIB_NO_WATERMARK=

# Token budget and timeouts (optional, see src/server/mcp/config.ts).
GETLIB_TOKEN_LIMIT=
GETLIB_MAX_TOKEN_LIMIT=
GETLIB_CACHE_TTL_MS=
GETLIB_FETCH_TIMEOUT_MS=
GETLIB_DEEP_FETCH_MAX_PAGES=
GETLIB_DEEP_FETCH_RELEVANCE_THRESHOLD=
GETLIB_DEEP_FETCH_TIMEOUT_MS=
GETLIB_MAX_CONCURRENT_FETCHES=
GETLIB_TOOL_TIMEOUT_MS=
GETLIB_SWR_STALE_TTL_MS=
GETLIB_CIRCUIT_BREAKER_THRESHOLD=
GETLIB_CIRCUIT_BREAKER_RESET_MS=
GETLIB_LOG_FORMAT=
GETLIB_LOG_LEVEL=
GETLIB_HTTP_PORT=

# Authentication (optional, the three work together).
# GETLIB_AUTHENTICATION_ENABLE=true requires sign-in verified against the
# default account below. When false or unset, the dashboard opens as guest.
# Never commit real values. Verification fails closed when unset.
GETLIB_AUTHENTICATION_ENABLE=
GETLIB_DEFAULT_ACCOUNT=
GETLIB_DEFAULT_PASS=
