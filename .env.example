# GetLib MCP - environment placeholders (no real values).
# Copy to .env for local development. Never commit real credentials.

# GitHub token for higher API rate limits (optional).
GETLIB_GITHUB_TOKEN=

# Persistent disk cache directory (optional, defaults to ~/.getlib-mcp-cache).
GETLIB_CACHE_DIR=

# Max concurrent fetch workers for auto-scan (optional, default 8).
GETLIB_CONCURRENCY=

# Set to 1 to disable invisible response watermarking (optional).
GETLIB_NO_WATERMARK=

# Token budget and timeouts (optional, see src/server/mcp/config.ts).
GETLIB_TOKEN_LIMIT=
GETLIB_MAX_TOKEN_LIMIT=
GETLIB_CACHE_TTL_MS=
GETLIB_FETCH_TIMEOUT_MS=
GETLIB_DEEP_FETCH_MAX_PAGES=
GETLIB_DEEP_FETCH_RELEVANCE_THRESHOLD=
GETLIB_DEEP_FETCH_TIMEOUT_MS=
GETLIB_MAX_CONCURRENT_FETCHES=
GETLIB_TOOL_TIMEOUT_MS=
GETLIB_SWR_STALE_TTL_MS=
GETLIB_CIRCUIT_BREAKER_THRESHOLD=
GETLIB_CIRCUIT_BREAKER_RESET_MS=
GETLIB_LOG_FORMAT=
GETLIB_LOG_LEVEL=

# Authentication (optional, the three work together).
# GETLIB_AUTHENTICATION_ENABLE=true requires sign-in verified against the
# default account below. When false or unset, the dashboard opens as guest.
# When the account variables are empty, the documented fallback
# (awesomemcp@getlib-local.com / getlib123) applies and the dashboard shows
# a rotation warning. Development mock mode also accepts demo@getlibmcp.com
# / demo123. Never commit real values. Verification fails closed when unset.
GETLIB_AUTHENTICATION_ENABLE=
GETLIB_DEFAULT_ACCOUNT=
GETLIB_DEFAULT_PASS=

# Runtime mode (see src/server/mcp/runtime.ts).
# GET_LIB_MODE=production or development. Explicit value always wins.
# When empty, the environment auto-detects from VERCEL_ENV / NODE_ENV
# (production signals yield production, development/test signals yield
# development) and otherwise defaults to production. Set
# GET_LIB_MODE=development for local work to unlock the Developments page
# and mock database. Production always uses Supabase and fails fast when
# configuration is missing.
GET_LIB_MODE=

# Runtime and database (see src/server/mcp/runtime.ts).
# Development defaults to mock. Set GETLIB_DATABASE_MODE=supabase to use a
# real development Supabase project. Production always uses Supabase and
# fails fast when configuration is missing. Never point development at
# production data.
GETLIB_DATABASE_MODE=
GETLIB_SUPABASE_URL=
GETLIB_SUPABASE_ANON_KEY=
GETLIB_SUPABASE_SERVICE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional allowlist for browser Origin validation on MCP transports.
GETLIB_ALLOWED_HOSTS=
